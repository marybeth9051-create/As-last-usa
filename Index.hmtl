<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AdBlast USA</title>
<style>*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}body{background:#f8fafc}header{background:#fff;padding:15px 5%;display:flex;justify-content:space-between;box-shadow:0 2px 10px rgba(0,0,0,.05)}.logo{font-weight:800;color:#2563eb;font-size:22px}.hero{background:linear-gradient(135deg,#2563eb,#1e40af);color:#fff;padding:50px 5%;text-align:center}.card{background:#fff;border-radius:16px;padding:20px;margin:20px 5%;box-shadow:0 4px 20px rgba(0,0,0,.05)}input,textarea,select{width:100%;padding:12px;border:2px solid #e2e8f0;border-radius:10px;margin:8px 0}.btn{width:100%;background:#2563eb;color:#fff;padding:16px;border:none;border-radius:12px;font-size:18px;font-weight:800}</style>
</head><body>
<header><div class="logo">AdBlast USA</div><div>🇺🇸 USA</div></header>
<div class="hero"><h1>Post One Ad to YouTube, Facebook, Instagram & Zangi</h1><p>Reach millions in USA</p></div>
<div class="card">
<h2>📢 Create Ad</h2>
<input placeholder="Ad Title e.g. iPhone Miami">
<textarea rows="3" placeholder="Description, price, location..."></textarea>
<select><option>New York</option><option>Los Angeles</option><option>Miami</option><option>All USA</option></select>
<p><input type="checkbox" checked> YouTube <input type="checkbox" checked> Facebook <input type="checkbox" checked> Instagram <input type="checkbox" checked> Zangi</p>
<button class="btn" onclick="alert('Success! Ad scheduled for USA!')">🚀 BLAST MY AD TO USA NOW</button>
</div>
</body></html>
